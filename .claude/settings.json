{
  "permissions": {
    "deny": ["Read(**/.env*)", "Read(**/*.pem)"],
    "ask": ["Edit(/public/**)", "Edit(/package-lock.json)", "Edit(/next.config.ts)", "Edit(/.github/**)"]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.sh",
            "timeout": 600
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/format.mjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/verify.mjs\"",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
